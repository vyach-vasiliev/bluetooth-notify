<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#F5F7FA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceHover">#EDF2F7</Color>
    <Color x:Key="Color.Border">#CBD3DE</Color>
    <Color x:Key="Color.Text">#172033</Color>
    <Color x:Key="Color.TextSecondary">#5B6575</Color>
    <Color x:Key="Color.Accent">#1769D2</Color>
    <Color x:Key="Color.Success">#188A4D</Color>
    <Color x:Key="Color.Warning">#A86600</Color>
    <Color x:Key="Color.Critical">#C83A47</Color>
    <Color x:Key="Color.Unknown">#7B8593</Color>

    <SolidColorBrush x:Key="Window.Background" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Surface.Background" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Border.Brush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Accent.Brush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Battery.Normal" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Battery.Low" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Battery.Critical" Color="{StaticResource Color.Critical}" />
    <SolidColorBrush x:Key="Battery.Unknown" Color="{StaticResource Color.Unknown}" />
    <SolidColorBrush x:Key="Logo.Background" Color="#E5EEFC" />
    <SolidColorBrush x:Key="Card.Border" Color="#18000000" />
    <SolidColorBrush x:Key="Icon.Background" Color="#EEF2F7" />
    <SolidColorBrush x:Key="Battery.Track" Color="#D9E0E8" />
    <SolidColorBrush x:Key="Status.Inactive" Color="#E7EBF0" />
    <SolidColorBrush x:Key="Status.Check" Color="White" />
    <SolidColorBrush x:Key="Focus.Border" Color="#702A7CFF" />
    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFF" />
</ResourceDictionary>
