<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#15171B</Color>
    <Color x:Key="Color.Surface">#1F2228</Color>
    <Color x:Key="Color.SurfaceHover">#272B32</Color>
    <Color x:Key="Color.Border">#343941</Color>
    <Color x:Key="Color.Text">#F5F7FA</Color>
    <Color x:Key="Color.TextSecondary">#9CA3AF</Color>
    <Color x:Key="Color.Accent">#4C93FF</Color>
    <Color x:Key="Color.Success">#35C46A</Color>
    <Color x:Key="Color.Warning">#F2B84B</Color>
    <Color x:Key="Color.Critical">#F05A67</Color>
    <Color x:Key="Color.Unknown">#59616D</Color>

    <SolidColorBrush x:Key="Window.Background" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Surface.Background" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Border.Brush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Accent.Brush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Battery.Normal" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Battery.Low" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Battery.Critical" Color="{StaticResource Color.Critical}" />
    <SolidColorBrush x:Key="Battery.Unknown" Color="{StaticResource Color.Unknown}" />
    <SolidColorBrush x:Key="Logo.Background" Color="#242D3C" />
    <SolidColorBrush x:Key="Card.Border" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="Icon.Background" Color="#14161A" />
    <SolidColorBrush x:Key="Battery.Track" Color="#30353D" />
    <SolidColorBrush x:Key="Status.Inactive" Color="#282D34" />
    <SolidColorBrush x:Key="Status.Check" Color="White" />
    <SolidColorBrush x:Key="Focus.Border" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="Input.Background" Color="#20242A" />
</ResourceDictionary>
