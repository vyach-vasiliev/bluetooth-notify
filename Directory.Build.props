<Project>
  <PropertyGroup>
    <Version>1.3.2</Version>
    <Company>Vasilev Viacheslav</Company>
    <Authors>Vasilev Viacheslav</Authors>
    <Copyright>Copyright © 2026 Vasilev Viacheslav</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vyach-vasiliev/bluetooth-notify</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
